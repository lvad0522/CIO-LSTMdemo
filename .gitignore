# 顶层只放行以下条目，其余（研究代码/数据/截图/文档/框架）一律忽略
/*
!/backend/
!/网站前端框架/
!/start.py
!/.gitignore
!/.gitattributes
!/README.md

# ---- 构建 / 运行产物 ----
node_modules/
dist/
__pycache__/
*.pyc
*.log
uploads/
*.egg-info/

# ---- 实验资产（实验室数据，不入库；来源见 backend/assets/README.md）----
backend/assets/*.mat
